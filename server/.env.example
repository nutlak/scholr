# Copy this file to server/.env and fill in real values.
# server/.env is gitignored — never commit real secrets.

# ── Supabase (required) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI (required for /api/generate-image) ───────────────────────
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Anthropic (required for /api/notebooks/:id/query and /forge) ────
CLAUDE_API_KEY=sk-ant-...

# ── Resend (required for OTP + invite emails) ───────────────────────
RESEND_API_KEY=re_...

# ── Misc ────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
