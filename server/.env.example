# Copy this file to server/.env and fill in real values.
# server/.env is gitignored — never commit real secrets.

# ── Supabase (required) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI (required for /api/generate-image) ───────────────────────
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Anthropic (required for /api/notebooks/:id/query and /forge) ────
CLAUDE_API_KEY=sk-ant-...

# ── Resend (required for OTP + invite emails) ───────────────────────
RESEND_API_KEY=re_...

# ── Misc ────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
PORT=3001

# Set to 1 when running against production credentials locally: keeps the email
# and renewal-reminder workers from sending real mail to real users.
DISABLE_WORKERS=0

# Local development only — point the Anthropic SDK at an Anthropic-compatible
# proxy (e.g. `omniclaude`'s router on http://localhost:20128) so test messages
# don't spend real credits. Leave BOTH unset in production: the Pro tier is
# sold as "Claude Sonnet", so production must actually call Anthropic.
# AI_BASE_URL=http://localhost:20128
# AI_MODEL_PRO=oc/deepseek-v4-flash-free
# AI_MODEL_FREE=oc/deepseek-v4-flash-free
